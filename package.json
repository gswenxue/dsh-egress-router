{
  "name": "dsh-egress-router",
  "version": "0.1.0",
  "description": "On-demand egress routing for DeepSeek Harness: import vless/vmess/trojan/ss nodes and let only blocked traffic use them. 给 DeepSeek Harness 的按需网络出海插件。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "proxy",
    "egress",
    "vless",
    "vmess",
    "reality",
    "sing-box",
    "github",
    "gfw"
  ],
  "author": "gswenxue",
  "license": "MIT",
  "homepage": "https://github.com/gswenxue/dsh-egress-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gswenxue/dsh-egress-router.git"
  },
  "bugs": {
    "url": "https://github.com/gswenxue/dsh-egress-router/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
